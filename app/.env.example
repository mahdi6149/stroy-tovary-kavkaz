# --- База данных ---
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app
DATABASE_URL=postgres://app:changeme@db:5432/app

# --- Админ-панель (/admin) ---
# ADMIN_PASSWORD — пароль для входа в /admin
# ADMIN_TOKEN — секретный токен сессии, который сервер выдаёт после успешного логина
# (сгенерировать: openssl rand -hex 24)
ADMIN_PASSWORD=changeme
ADMIN_TOKEN=changeme

# --- Telegram-уведомления о новых заказах ---
# Токен бота от @BotFather. НИКОГДА не используется во фронтенде — только здесь, на сервере.
TELEGRAM_BOT_TOKEN=
# ID чата, куда слать уведомления (твой личный chat_id или ID группы/канала).
# Как узнать: напиши боту любое сообщение, затем открой в браузере
# https://api.telegram.org/bot<TOKEN>/getUpdates — там будет "chat":{"id": ...}
TELEGRAM_CHAT_ID=

# --- Reverse-proxy / HTTPS ---
# Домен не нужен: используем nip.io — бесплатный сервис, который резолвит
# IP-адрес прямо в имени в "домен". Вписать реальный IP через дефисы вместо точек,
# например для 159.65.1.1: DOMAIN=159-65-1-1.nip.io
# Caddy сам получит настоящий HTTPS-сертификат Let's Encrypt для этого имени.
DOMAIN=159-65-1-1.nip.io
ACME_EMAIL=mbulatov@gmail.com
